# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# 1000MB Storage Production Configuration
# Cloud Storage & Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-app.appspot.com

# SMS & OTP Gateway Configuration (e.g. Twilio, Greenweb, SSL Wireless, etc.)
SMS_PROVIDER_API_KEY=your-sms-api-key
SMS_PROVIDER_SENDER_ID=your-sender-id
SMS_GATEWAY_URL=https://api.sms-provider.com/v1/send

# Admin Panel Authorization Token (Verified server-side)
ADMIN_SECRET_KEY=secure-admin-token-placeholder

